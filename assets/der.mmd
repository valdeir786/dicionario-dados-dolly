erDiagram
  usuario {
    INT id_usuario PK
    VARCHAR_100_ nome
    VARCHAR_100_ login
    VARCHAR_255_ senha_hash
    ENUM__Admin____Gerente____Operador__ perfil
    TINYINT ativo
  }
  cliente {
    INT id_cliente PK
    VARCHAR_150_ nome
    VARCHAR_150_ email
    VARCHAR_14_ cpf_cnpj
    VARCHAR_20_ telefone
    TINYINT consent_lgpd
    DATETIME data_consentimento
    TINYINT ativo
  }
  endereco {
    INT id_endereco PK
    INT id_cliente FK
    VARCHAR_200_ logradouro
    VARCHAR_20_ numero
    VARCHAR_100_ complemento
    VARCHAR_100_ bairro
    VARCHAR_100_ cidade
    CHAR_2_ uf
    CHAR_8_ cep
  }
  fornecedor {
    INT id_fornecedor PK
    VARCHAR_150_ razao_social
    VARCHAR_14_ cnpj
    VARCHAR_100_ contato
    TINYINT ativo
  }
  categoria {
    INT id_categoria PK
    VARCHAR_100_ nome
    TINYINT ativo
  }
  produto {
    INT id_produto PK
    INT id_categoria FK
    INT id_fornecedor FK
    VARCHAR_200_ descricao
    DECIMAL_10_2_ preco_tabela
    INT saldo_estoque
    TINYINT ativo
  }
  lote {
    INT id_lote PK
    INT id_produto FK
    VARCHAR_50_ numero_lote
    INT quantidade_inicial
    INT quantidade_atual
    DATE data_fabricacao
    DATE data_validade
  }
  preco_regiao {
    INT id_preco_regiao PK
    INT id_produto FK
    CHAR_2_ uf
    DECIMAL_10_2_ preco_vigente
  }
  promocao {
    INT id_promocao PK
    VARCHAR_150_ descricao
    DECIMAL_5_2_ percentual_desconto
    DATE data_inicio
    DATE data_fim
    TINYINT ativo
  }
  pedido {
    INT id_pedido PK
    INT id_cliente FK
    INT id_usuario FK
    INT id_endereco FK
    TIMESTAMP data_hora
    ENUM__ABERTO____FINALIZADO____CANCELADO__ situacao
    VARCHAR_50_ forma_pagamento
    DECIMAL_10_2_ valor_total
    DECIMAL_10_2_ valor_desconto
    DATETIME data_cancelamento
  }
  item_pedido {
    INT id_item PK
    INT id_pedido FK
    INT id_produto FK
    INT id_promocao FK
    INT quantidade
    DECIMAL_10_2_ preco_unitario_venda
  }
  item_pedido_lote {
    INT id_item_pedido_lote PK
    INT id_item FK
    INT id_lote FK
    INT id_produto FK
    INT quantidade
    INT quantidade_estornada
  }
  nota_fiscal {
    INT id_nota_fiscal PK
    INT id_pedido FK
    CHAR_44_ chave_acesso
    DECIMAL_10_2_ valor_total_nf
    DATETIME data_emissao
  }
  conta_receber {
    INT id_conta PK
    INT id_pedido FK
    INT numero_parcela
    DECIMAL_10_2_ valor_parcela
    DATE data_vencimento
    ENUM__PENDENTE____PAGO____CANCELADO__ status_parcela
  }
  pagamento {
    INT id_pagamento PK
    INT id_pedido FK
    ENUM__BOLETO____PIX____CARTAO__ forma_pagamento
    DECIMAL_10_2_ valor_pago
    ENUM__PENDENTE____CONFIRMADO____CANCELADO____ESTORNADO__ status_pagamento
    DATETIME data_transacao
  }
  entrega {
    INT id_entrega PK
    INT id_pedido FK
    INT id_usuario_motorista FK
