    DATETIME data_realizada
  }
  comprovante_entrega {
    INT id_comprovante PK
    INT id_pedido FK
    TEXT assinatura_digital_canhoto
    DATETIME data_registro
  }
  estorno {
    INT id_estorno PK
    INT id_pedido FK
    TEXT motivo
    DATETIME data_estorno
  }
  log_auditoria {
    INT id_log PK
    INT id_usuario FK
    VARCHAR_100_ tabela_afetada
    VARCHAR_20_ operacao
    TIMESTAMP data_hora
    JSON valor_anterior
    JSON valor_novo
  }
